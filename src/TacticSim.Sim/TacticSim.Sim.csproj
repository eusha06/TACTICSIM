<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Rules and balance numbers live in /content. They ship inside the engine so the
       server, tests and balance tool always read the same versioned files. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\content\**\*.json" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
