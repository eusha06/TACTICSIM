@page
@model ErrorModel
@{ ViewData["Title"] = "Operation unavailable"; }
<div class="game-shell message-page">
    <p class="eyebrow">CONNECTION TO COMMAND</p>
    <h1>Operation temporarily unavailable.</h1>
    <p>We could not complete this request. Your previously saved actions remain available in this browser.</p>
    <p>Return to the battlefield and retry. A repeated command can only apply once.</p>
    <a class="button primary" asp-page="/Index">Return to battlefield</a>
    <a class="button secondary" asp-page="/History">Saved operations</a>
    @if (Model.ShowRequestId) { <p class="micro-note">Support reference: <code>@Model.RequestId</code></p> }
</div>
