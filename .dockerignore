# Allow only inputs required for the web publish. No Git, local settings, data,
# dumps, keys, tests, or credentials enter the build context.
**
!global.json
!src/
!src/TacticSim.Core/
!src/TacticSim.Core/**
!src/TacticSim.Web/
!src/TacticSim.Web/**
!src/TacticSim.Sim/
!src/TacticSim.Sim/**
!content/
!content/**
!client/
!client/**
client/node_modules/
client/test/
**/wwwroot/game/
**/bin/
**/obj/
**/.env*
**/appsettings.*.json
!src/TacticSim.Web/appsettings.json
**/*.secrets.json
**/*.db*
**/*.dump
**/*.backup
**/*.pfx
**/*.pem
**/keys/
**/Properties/
