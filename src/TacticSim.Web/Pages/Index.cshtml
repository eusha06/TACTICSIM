@page
@model IndexModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = "Operation Rivergate";
}
<div id="game-app" class="game-shell" data-art-url="@FileVersionProvider.AddFileVersionToPath(Request.PathBase, Url.Content("~/art/battlefield.svg"))" data-state-url="@Url.Page("/Index", "State")" data-command-url="@Url.Page("/Index", "Command")">
    @Html.AntiForgeryToken()
    <div id="error" class="error-banner" role="alert" hidden><span id="error-text"></span><button id="retry" type="button">Retry</button></div>
    <section id="welcome" class="welcome" aria-labelledby="welcome-title">
        <p class="eyebrow">TACTICSIM</p>
        <h1 id="welcome-title" tabindex="-1">TacticSim: Operation Rivergate</h1>
        <p class="welcome-intro">Lead three blue units against a deterministic orange opponent. Fight your way to the communications outpost at F4, then defend it.</p>
        <p class="welcome-objective"><span>YOUR OBJECTIVE</span><strong>Capture and hold the communications outpost.</strong></p>
        <div class="welcome-actions">
            <button id="continue-operation" class="button primary" type="button" hidden disabled>Continue Operation</button>
            <button id="begin-operation" aria-describedby="welcome-status" class="button primary" type="button" disabled>Begin Operation</button>
            <button class="button secondary help-open" type="button">How to Play</button>
        </div>
        <p class="welcome-note">Keep any friendly unit alive on F4 through @TacticSim.Core.Game.RequiredHoldRounds completed human-plus-computer rounds. Losing occupancy resets progress. Even after clearing the enemy, finish the hold.</p>
        <p id="welcome-status" class="welcome-status" role="status">Checking for a saved operation…</p>
        <a class="welcome-history" asp-page="/History">Review saved matches</a>
        <div class="welcome-miniatures" aria-hidden="true">
            @foreach (var unit in Model.GuideUnits)
            {
                <svg viewBox="0 0 100 100"><use href="@FileVersionProvider.AddFileVersionToPath(Request.PathBase, Url.Content("~/art/battlefield.svg"))#@unit.GetType().Name.ToLowerInvariant()" /></svg>
            }
        </div>
    </section>
    <div id="play-area" hidden>
    <div class="page-heading">
        <div><p class="eyebrow">TACTICSIM / FIELD EDITION</p><h1 id="play-title" tabindex="-1">Operation Rivergate<span>.</span></h1><p class="intro">Move, attack, and protect your squad. Follow this operation’s objective.</p></div>
        <div class="play-tools"><button id="show-briefing" class="button secondary" type="button">Briefing</button><button class="button secondary help-open" type="button">How to Play</button><button id="new-match" class="button secondary" type="button" disabled><span aria-hidden="true">↻</span> New Match</button></div>
    </div>
    <section id="tutorial" class="tutorial" aria-labelledby="tutorial-title" hidden>
        <div class="tutorial-copy" role="status" aria-live="polite" aria-atomic="true"><p id="tutorial-step" class="eyebrow"></p><h2 id="tutorial-title"></h2><p id="tutorial-message"></p></div>
        <div class="tutorial-actions"><button id="tutorial-done" class="button primary" type="button" hidden>Got it</button><button id="tutorial-skip" class="button secondary" type="button">Skip Tutorial</button></div>
    </section>
    <section id="mission-status" class="mission-status" aria-labelledby="mission-title">
        <div><p class="eyebrow" id="mission-title">OPERATION OBJECTIVE</p><p id="objective-progress" class="objective-progress" role="status" aria-live="polite"></p><p id="objective-instructions"></p></div>
    </section>
    <div class="action-feedback" aria-label="Action feedback">
        <p id="action-message" role="status" aria-live="polite" aria-atomic="true">Ready for orders.</p>
        <button id="skip-sequence" aria-keyshortcuts="Escape" title="Skip animation (Esc)" class="button secondary" type="button" hidden>Skip animation</button>
    </div>
    <div id="victory" tabindex="-1" class="victory-banner" role="status" hidden></div>
    <div class="battle-layout">
        <section class="battle-panel" aria-label="Battlefield">
            <div class="panel-topline"><div class="operation-label"><span class="live-dot"></span> THE CROSSING <span class="muted">/ 8 × 8</span></div><span id="turn-label" class="turn-label" aria-live="polite">Connecting…</span></div>
            <div class="board-frame">
                <div class="column-labels" aria-hidden="true">@foreach (var letter in "ABCDEFGH") { <span>@letter</span> }</div>
                <div class="row-labels" aria-hidden="true">@for (var row = 1; row <= 8; row++) { <span>@row</span> }</div>
                <div id="board" class="board" role="group" aria-label="8 by 8 tactical board" aria-busy="true" aria-describedby="board-controls"></div>
            </div>
            <p id="board-controls" class="board-controls">Select a blue unit, then a marked cell to move or an outlined opponent to attack. Keyboard: arrows to navigate, Enter to choose, Esc to deselect.</p>
            <div class="board-caption"><span><i class="sample move-sample"></i> Legal move <i class="sample attack-sample"></i> Attack target</span><span id="board-hint" role="status">Loading your battlefield…</span></div>
            <div class="terrain-legend" aria-label="Terrain legend"><span class="legend-title">TERRAIN</span><span><i class="terrain-sample plain"></i> Grass <small>plain</small></span><span><i class="terrain-sample forest"></i> Forest <small>+1 defense</small></span><span><i class="terrain-sample hill"></i> Hill <small>+2 defense</small></span><span><i class="terrain-sample water"></i> Water <small>impassable</small></span></div>
        </section>
        <aside class="command-column">
            <section class="panel turn-panel"><p class="eyebrow">COMMAND POST</p><div class="turn-heading"><span class="side-dot human"></span><h2 id="turn-title">Stand by</h2><span id="turn-number" class="number-badge">—</span></div><p id="turn-description">Retrieving your saved match.</p><button id="end-turn" class="button primary" type="button" disabled>End Turn <span aria-hidden="true">→</span></button><p class="micro-note">The opponent plays after you end your turn.</p></section>
            <section class="panel unit-panel"><div class="section-heading"><h2>Unit intel</h2><span class="eyebrow">SELECT TO INSPECT</span></div><div id="unit-details"><p class="empty-state">Select a blue unit on the board to see its stats and legal actions.</p></div>
                <div class="squad-panel" aria-label="Your squad selection"><div class="section-heading"><h2>Your squad</h2><span id="squad-count" class="eyebrow">3 UNITS</span></div><div id="squad"></div></div></section>
        </aside>
    </div>
    <div class="lower-layout">
        <details class="panel history-panel"><summary class="section-heading"><div><p class="eyebrow">FIELD NOTES</p><h2>Action history</h2></div><span id="history-count" class="subtle-badge">0 actions</span></summary><p class="history-note">Accepted actions, newest first. This is a history, not a replay.</p><ol id="history" class="history-list" aria-label="Action history, newest first"><li class="empty-state">Your actions will appear here.</li></ol></details>
        <details class="panel briefing-panel"><summary>Quick reminders</summary><ol class="briefing-list"><li><b>Choose your unit.</b><span>Blue is your squad. Orange is the opponent.</span></li><li><b>Move, then attack.</b><span>One of each per unit. Attacking ends its movement.</span></li><li><b>Use the ground.</b><span>Rough terrain slows you; forests and hills protect you.</span></li></ol><p class="briefing-note">Artillery range: 2–4 cells. Terrain does not block line of sight. No random combat.</p><details><summary>Recent completed matches</summary><ul id="results" class="results-list"><li>No completed matches yet.</li></ul></details></details>
    </div>
    </div>
    <dialog id="help-dialog" class="help-dialog" aria-labelledby="help-title">
        <div class="help-heading"><h2 id="help-title">How to Play</h2><button id="close-help" class="button secondary" type="button" autofocus>Close help</button></div>
        <p id="help-objective">New Rivergate objective: hold the communications outpost at F4 through @TacticSim.Core.Game.RequiredHoldRounds completed rounds. Older saves keep their elimination objective.</p>
        <p>Blue units are yours; orange units are the opponent. Their silhouettes and names identify Infantry, Armor and Artillery.</p>
        <p id="help-capture">Any surviving friendly unit can occupy F4. The count updates once after the computer finishes. Keep friendly occupancy through two consecutive round checks; moving off, even briefly, or losing the holder resets it. Losing your entire squad means defeat. Eliminating every opponent does not win by itself: occupy the outpost and finish the hold using End Turn.</p>
        <ol class="help-steps"><li><b>Select a blue unit.</b> Its details show remaining Move and Attack actions.</li><li><b>Move, then attack.</b> Each unit may move once and attack once per turn. A move is optional; attacking locks movement for that turn.</li><li><b>Choose marked cells.</b> Round markers are legal moves; their numbers show total route cost. Dashed orange targets can be attacked. Movement is four-directional; attack distance counts horizontal and vertical cells.</li><li><b>End Turn.</b> The computer uses the same rules and responds immediately. Your surviving units receive fresh actions on your next turn.</li></ol>
        <h3>Units and terrain</h3>
        <p>These values come from the current game rules. Spend up to a unit's movement budget in one move. Water and occupied cells cannot be crossed.</p>
        @foreach (var unit in Model.GuideUnits)
        {
            <p class="help-unit"><b>@unit.GetType().Name</b> · @unit.MaxHealth health · @unit.MovementPoints movement budget · range @unit.MinimumRange–@unit.MaximumRange cells</p>
        }
        <div class="table-scroll"><table class="unit-table"><caption>Movement cost to enter a cell; defense reduces incoming damage.</caption><thead><tr><th>Terrain</th><th>Defense</th>@foreach (var unit in Model.GuideUnits) { <th>@unit.GetType().Name</th> }</tr></thead><tbody>
        @foreach (var terrain in Model.GuideTerrains)
        {
            <tr><th>@terrain</th><td>@Model.Defense(terrain)</td>@foreach (var unit in Model.GuideUnits) { <td>@(unit.GetMovementCost(terrain)?.ToString() ?? "Impassable")</td> }</tr>
        }
        </tbody></table></div>
        <p>Forests and hills protect the unit standing on them. Damage is base damage minus the target terrain's defense, with a minimum of 1. Terrain does not block line of sight.</p>
        <p>Artillery cannot attack inside its minimum range. Select it to see its current range; the server marks valid targets and explains rejected actions.</p>
        <p><b>Keyboard:</b> Tab to controls or a board cell, arrows to navigate, Enter or Space to select, Escape to deselect. Progress belongs to this browser; keep its cookies to continue your saves. Action history records accepted actions and is not a replay.</p>
        <button id="replay-tutorial" class="button primary" type="button" disabled>Replay Tutorial</button><p id="replay-note" class="micro-note">Begin or continue an operation to practice without resetting it.</p>
    </dialog>
    <dialog id="new-dialog"><p class="eyebrow">NEW OPERATION</p><h2>Start a fresh match?</h2><p>Your current match stays saved in Match history. A fresh match will become active.</p><div class="dialog-actions"><button id="cancel-new" class="button secondary" type="button">Keep playing</button><button id="confirm-new" class="button primary" type="button">Start New Match</button></div></dialog>
    <noscript><p class="error-banner">Enable JavaScript to play. The server validates all moves and attacks.</p></noscript>
</div>
@section Scripts {
    <script src="~/js/tutorial.js" asp-append-version="true" defer></script>
    <script src="~/js/presentation.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
}
